# Axis Assistant – Backend
APP_NAME=axis-assistant
APP_PORT=8080
APP_ENV=development

# Single-owner API key (used by dashboard & agent)
API_KEY=change-me-to-a-strong-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=axis
DB_PASSWORD=axis_secret
DB_NAME=axis_assistant
DB_SSLMODE=disable

# AI Orchestrator
AI_ORCHESTRATOR_URL=http://localhost:8000

# Google OAuth (for Gmail & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# WhatsApp (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_TOKEN=
