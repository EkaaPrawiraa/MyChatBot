# Axis Assistant – Backend
APP_NAME=axis-assistant
APP_PORT=8080
APP_ENV=development

# Single-owner API key (used by dashboard & agent)
API_KEY=change-me-to-a-strong-key

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=axis
DB_PASSWORD=axis_secret
DB_NAME=axis_assistant
DB_SSLMODE=disable

# AI Orchestrator
AI_ORCHESTRATOR_URL=http://localhost:8000

# Dashboard URL (optional) - where to redirect the browser after OAuth connects
# Example (Next.js dev): http://localhost:3005
DASHBOARD_URL=

# Google OAuth (for Gmail & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the backend route: GET /api/v1/integrations/google/callback
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google/callback

# WhatsApp (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_TOKEN=

# WhatsApp Web Bot (local, QR-scan based)
WHATSAPP_BOT_URL=http://localhost:3100

# X (OAuth)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Tavily web search (optional)
TAVILY_API_KEY=
