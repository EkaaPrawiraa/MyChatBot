    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "profile"]
            },
            "description": "Fetch the owner's profile.\n\nThe `ai_api_key` is **never** returned in plaintext — only a masked version (`ai_api_key_masked`) is included."
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Eka\",\n  \"email\": \"eka@example.com\",\n  \"preferred_meeting_hours\": \"09:00-12:00\",\n  \"focus_hours\": \"14:00-17:00\",\n  \"communication_style\": \"concise\",\n  \"work_pattern\": \"morning person\",\n  \"ai_provider\": \"openai\",\n  \"ai_api_key\": \"sk-proj-...\",\n  \"ai_model\": \"gpt-4o-mini\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "profile"]
            },
            "description": "Update the owner's profile. All fields are optional (PATCH-like behavior).\n\n**AI Provider values:** `openai`, `anthropic`, `xai`\n\nThe `ai_api_key` is stored securely and masked in GET responses."
          },
          "response": []
        },
        {
          "name": "Update AI Provider (Anthropic)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ai_provider\": \"anthropic\",\n  \"ai_api_key\": \"sk-ant-...\",\n  \"ai_model\": \"claude-sonnet-4-20250514\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "profile"]
            },
            "description": "Example: switch to Anthropic Claude."
          },
          "response": []
        },
        {
          "name": "Update AI Provider (xAI/Grok)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ai_provider\": \"xai\",\n  \"ai_api_key\": \"xai-...\",\n  \"ai_model\": \"grok-3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "profile"]
            },
            "description": "Example: switch to xAI Grok."
          },
          "response": []
        }
      ],
      "description": "Owner profile management. Single owner — always `id = 1`.\n\nSupports switching AI providers (OpenAI, Anthropic, xAI)."
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "    pm.environment.set('session_id', json.data.id);",
                  "    console.log('✅ session_id saved: ' + json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions"]
            },
            "description": "Create a new chat session. No request body needed.\n\nThe returned `id` is automatically saved to the `session_id` environment variable for use in subsequent requests."
          },
          "response": []
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions"],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Max sessions to return (default: 20)"
                }
              ]
            },
            "description": "List recent chat sessions, newest first."
          },
          "response": []
        },
        {
          "name": "Get Session by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}"]
            },
            "description": "Fetch a single session by UUID."
          },
          "response": []
        },
        {
          "name": "Close Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}/close",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}", "close"]
            },
            "description": "Mark a session as inactive (closed). Returns `204 No Content`."
          },
          "response": []
        }
      ],
      "description": "Chat session lifecycle — create, list, get, close."
    },
