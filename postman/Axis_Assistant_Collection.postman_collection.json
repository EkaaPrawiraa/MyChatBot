    {
      "name": "Sessions",
      "description": "Create/list/get/close/delete sessions and fetch message history.",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Save session_id to environment', function () {",
                  "  const json = pm.response.json();",
                  "  if (json.success && json.data && json.data.id) {",
                  "    pm.environment.set('session_id', json.data.id);",
                  "    console.log('✅ session_id saved: ' + json.data.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{base_url}}/api/v1/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions"]
            },
            "description": "Creates a session. Empty JSON body is allowed."
          },
          "response": []
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/sessions?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          },
          "response": []
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Session Messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}/messages?limit=200",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}", "messages"],
              "query": [{ "key": "limit", "value": "200" }]
            },
            "description": "Returns the short-term conversation memory so the dashboard can render ChatGPT-style history."
          },
          "response": []
        },
        {
          "name": "Close Session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}/close",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}", "close"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "{{session_id}}"]
            },
            "description": "Deletes a session and its short-term conversation history (FK cascade)."
          },
          "response": []
        }
      ]
    },
